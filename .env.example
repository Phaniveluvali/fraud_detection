# Copy to .env and adjust. Every setting is documented in src/invoice_guard/config.py.
IG_MAX_UPLOAD_MB=25
IG_MAX_PAGES=10
IG_RENDER_DPI=150
IG_WORKERS=4
IG_DB_PATH=invoice_guard.db
IG_ENABLE_DUPLICATE_STORE=true
IG_LOG_LEVEL=INFO

# Calibrate on your own invoices before relying on these.
IG_REVIEW_THRESHOLD=25
IG_HIGH_THRESHOLD=60
IG_ELA_Z_MIN=2.0
IG_ELA_RATIO_MIN=1.8

# Field extraction with an Ollama vision model. Page images are sent to this server.
IG_ENABLE_EXTRACTION=true
IG_OLLAMA_URL=http://localhost:11434
IG_OLLAMA_MODEL=qwen2.5vl:7b
IG_OLLAMA_FALLBACK_MODEL=qwen2.5vl:3b
IG_OLLAMA_TIMEOUT=240
